---
import { clinic } from "../data/clinic";
import ficaLogo from "../assets/fica_logo.jpeg";
import { Image } from "astro:assets";
import ThemeSelector from "./ThemeSelector.astro";

const whatsappText = encodeURIComponent(
  "Olá! Gostaria de marcar uma consulta."
);
const whatsappLink = `https://wa.me/${clinic.phoneE164.replace("+", "")}?text=${whatsappText}`;
const mapsLink = clinic.mapsLink;
---

<div
  class="sticky top-0 z-50 border-b border-line bg-nav shadow-[0_8px_24px_rgba(23,27,48,0.05)] backdrop-blur"
>
  <div class="container">
    <div
      class="grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-2 py-2.5 sm:flex sm:flex-wrap sm:justify-between"
    >
      <a
        href="#"
        class="group inline-flex w-fit items-center gap-2.5 rounded-lg pr-2 text-heading hover:text-primary"
        aria-label="Ir para o início"
      >
        <span
          class="grid h-9 w-9 place-items-center overflow-hidden rounded-lg bg-brand-900 shadow-[0_8px_18px_rgba(23,27,48,0.14)] ring-1 ring-line"
          aria-hidden="true"
        >
          <Image
            src={ficaLogo}
            alt=""
            loading="eager"
            class="h-full w-full object-cover"
          />
        </span>
        <span class="flex flex-col">
          <span class="text-sm font-semibold leading-none sm:text-base">
            {clinic.name}
          </span>
          <span
            class="mt-1 h-0.5 w-9 rounded-full bg-accent-500 transition-all duration-200 group-hover:w-full"
            aria-hidden="true"
          >
          </span>
        </span>
      </a>

      <div class="contents sm:flex sm:flex-wrap sm:items-center sm:gap-2">
        <nav
          class="order-3 col-span-2 flex flex-wrap items-center gap-1 text-sm sm:order-none"
          aria-label="Navegação principal"
        >
          <a class="btn-ghost min-h-0 px-2.5! py-1.5!" href="#servicos">
            Serviços
          </a>
          <a class="btn-ghost min-h-0 px-2.5! py-1.5!" href="#equipa">
            Equipa
          </a>
          <a class="btn-ghost min-h-0 px-2.5! py-1.5!" href="#contactos">
            Contactos
          </a>
        </nav>

        <div class="order-2 justify-self-end sm:order-none">
          <ThemeSelector />
        </div>
      </div>
    </div>
  </div>
</div>

<header class="bg-brand-wash pt-8 pb-12 md:pt-10 md:pb-20" data-reveal>
  <div class="container">
    <div class="card p-5 sm:p-6 md:p-10">
      <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-center">
        <div class="flex justify-center md:justify-start" data-reveal-child>
          <Image
            src={ficaLogo}
            alt={clinic.name}
            loading="eager"
            class="w-44 sm:w-56 md:w-64 lg:w-72 aspect-square object-contain"
          />
        </div>

        <div class="text-center md:text-left" data-reveal-child>
          <p
            class="mx-auto flex w-fit items-center gap-3 text-sm font-semibold text-heading md:mx-0"
          >
            <span class="h-px w-10 bg-accent-500" aria-hidden="true"></span>
            <span class="leading-none">{clinic.name}</span>
            <span class="h-px w-10 bg-accent-500" aria-hidden="true"></span>
          </p>

          <p class="mt-3 text-muted max-w-xl mx-auto md:mx-0">
            {
              clinic.tagline ??
                "Fisioterapia e Osteopatia — acompanhamento individualizado, sob marcação."
            }
          </p>

          <h1 class="mt-3 text-balance">
            Cuidados especializados em{" "}
            <span class="text-primary">Fisioterapia</span>{" "}
            e{" "}
            <span class="text-primary">Osteopatia</span>
          </h1>

          <p class="mt-4 text-muted max-w-xl mx-auto md:mx-0">
            Reabilitação, terapia manual e exercício clínico — com foco no seu
            objetivo e na sua recuperação.
          </p>

          <div
            class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap justify-center md:justify-start"
          >
            <a
              class="btn-primary"
              href={whatsappLink}
              target="_blank"
              rel="noopener"
            >
              Marcar por WhatsApp
            </a>
            <a class="btn-secondary" href={`tel:${clinic.phoneE164}`}>Ligar</a>
            <a class="btn-secondary" href={`mailto:${clinic.email}`}>Email</a>
          </div>

          <div
            class="mt-6 flex flex-wrap gap-2 justify-center md:justify-start"
          >
            <span class="chip">{clinic.phoneDisplay}</span>
            <span class="chip">
              {clinic.addressShort ?? "Castêlo da Maia, Maia"}
            </span>
            <a class="chip" href={mapsLink} target="_blank" rel="noopener">
              Abrir no Maps
            </a>
          </div>
        </div>
      </div>

      <div
        class="mt-8 grid gap-5 border-t border-line pt-6 sm:grid-cols-3"
        data-reveal-child
      >
        <div class="text-center sm:text-left">
          <div class="text-xs font-semibold text-muted">Dias úteis</div>
          <div class="mt-2 font-semibold text-heading">8h – 20h</div>
          <div class="text-sm text-muted mt-1">Sob marcação</div>
        </div>

        <div class="text-center sm:text-left">
          <div class="text-xs font-semibold text-muted">Sábado</div>
          <div class="mt-2 font-semibold text-heading">8h – 13h</div>
          <div class="text-sm text-muted mt-1">Sob marcação</div>
        </div>

        <div class="text-center sm:text-left">
          <div class="text-xs font-semibold text-muted">
            Resposta rápida
          </div>
          <div class="mt-2 font-semibold text-heading">WhatsApp</div>
          <div class="text-sm text-muted mt-1">Marcação e dúvidas</div>
        </div>
      </div>
    </div>
  </div>
</header>
