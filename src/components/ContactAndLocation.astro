---
import { Image } from "astro:assets";
import { clinic } from "../data/clinic";
import gmapsImg from "../assets/google_maps_screenshot.png";

const whatsappText = encodeURIComponent(
  "Olá! Gostaria de marcar uma consulta."
);
const whatsappLink = `https://wa.me/${clinic.phoneE164.replace("+", "")}?text=${whatsappText}`;

const imgAlt = "Mapa da localização do Gabinete FICA em Castêlo da Maia";
---

<section id="contactos" class="section bg-panel" data-reveal>
  <div class="container">
    <div class="section-head text-center">
      <h2 class="text-balance">Contactos e localização</h2>
      <p class="subtitle mx-auto">
        Marque a sua consulta e encontre-nos facilmente no Castêlo da Maia.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="card p-6 md:p-8">
        <div class="chip-accent inline-flex">Contactos</div>

        <dl class="mt-5 divide-y divide-line">
          <div class="py-4 first:pt-0">
            <dt class="text-xs font-semibold text-muted">Morada</dt>
            <dd class="mt-1 font-semibold text-heading">
              {clinic.address}
            </dd>
          </div>

          <div class="py-4">
            <dt class="text-xs font-semibold text-muted">Telefone</dt>
            <dd class="mt-1 font-semibold text-heading">
              {clinic.phoneDisplay}
            </dd>
            <a
              class="mt-2 inline-block text-sm"
              href={`tel:${clinic.phoneE164}`}>Ligar</a
            >
          </div>

          <div class="py-4">
            <dt class="text-xs font-semibold text-muted">Email</dt>
            <dd class="mt-1 break-words font-semibold text-heading">
              {clinic.email}
            </dd>
            <a
              class="mt-2 inline-block text-sm"
              href={`mailto:${clinic.email}`}>Enviar email</a
            >
          </div>
        </dl>

        <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            class="btn-primary"
            href={whatsappLink}
            target="_blank"
            rel="noopener">Marcar por WhatsApp</a
          >
          <a class="btn-secondary" href={`tel:${clinic.phoneE164}`}>Ligar</a>
          <a class="btn-secondary" href={`mailto:${clinic.email}`}>Email</a>
        </div>

        <p class="mt-5 text-sm text-muted">Atendimento sob marcação.</p>
      </div>

      <a
        class="card block overflow-hidden transition duration-200 hover:-translate-y-0.5"
        href={clinic.mapsLink}
        target="_blank"
        rel="noopener"
        aria-label={`Abrir localização do ${clinic.name} no Google Maps`}
      >
        <div class="relative">
          <Image
            src={gmapsImg}
            alt={imgAlt}
            loading="lazy"
            class="theme-map h-[340px] w-full object-cover md:h-[430px]"
          />
          <div class="absolute left-4 bottom-4">
            <span class="chip">Abrir no Google Maps</span>
          </div>
        </div>

        <div class="p-5 md:p-6">
          <div class="font-semibold text-heading">Localização</div>
          <div class="text-muted text-sm mt-1">{clinic.address}</div>
        </div>
      </a>
    </div>
  </div>
</section>
