---
import type { TeamMember } from "../types/team";
const { member } = Astro.props as { member: TeamMember };
---

<article class="card h-full overflow-hidden">
  <div class="grid h-full md:grid-cols-2">
    <div class="relative">
      <img
        src={member.image}
        alt={`Fotografia de ${member.name}`}
        loading="lazy"
        class="h-80 w-full object-cover sm:h-96 md:h-full md:min-h-[25rem]"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-brand-900/12 via-transparent to-transparent"
      >
      </div>
    </div>

    <div class="p-6 md:p-7">
      <h3 class="text-lg font-semibold leading-tight text-heading md:text-xl">
        {member.name}
      </h3>
      <div class="text-muted text-sm mt-1">
        {member.role} • {member.license}
      </div>

      <div class="mt-5 text-xs font-semibold text-muted">
        Formação
      </div>

      <ul class="mt-3 list-disc space-y-2 pl-5">
        {
          member.qualifications.map((q) => (
            <li class="text-muted text-sm leading-relaxed">
              {q}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
