---
import { Image } from "astro:assets";
import { clinic } from "../data/clinic";
import ficaLogo from "../assets/fica_logo.jpeg";
const year = new Date().getFullYear();
---

<footer class="bg-footer text-white">
  <div class="container py-12 md:py-14">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-[1.15fr_1fr_1fr_0.8fr]">
      <div>
        <div class="flex items-center gap-3">
          <Image
            src={ficaLogo}
            alt=""
            loading="lazy"
            class="h-12 w-12 rounded-lg object-cover ring-1 ring-line"
          />
          <div>
            <div class="font-semibold leading-none">{clinic.name}</div>
            <div class="text-footer-muted text-sm">{clinic.tagline}</div>
          </div>
        </div>

        <p class="mt-4 text-footer-muted text-sm max-w-sm">
          Cuidados especializados em fisioterapia e osteopatia, com
          acompanhamento individualizado e foco na recuperação funcional.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Contactos</h3>

        <ul class="mt-4 space-y-2 text-sm text-footer-muted">
          <li>{clinic.address}</li>
          <li>
            <a
              href={`tel:${clinic.phoneE164}`}
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              {clinic.phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${clinic.email}`}
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              {clinic.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Navegação</h3>

        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a
              href="#servicos"
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              Serviços
            </a>
          </li>
          <li>
            <a
              href="#equipa"
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              Equipa
            </a>
          </li>
          <li>
            <a
              href="#contactos"
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              Contactos
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Informação legal</h3>

        <ul class="mt-4 space-y-3 text-sm text-footer-muted">
          <li>
            N.º de registo de estabelecimento:{" "}
            <strong class="font-semibold text-white">
              {clinic.legal.establishmentRegistration}
            </strong>
          </li>
          <li>
            Licença de funcionamento n.º{" "}
            <strong class="font-semibold text-white">
              {clinic.legal.operatingLicense}
            </strong>
          </li>
          <li>
            NIPC:{" "}
            <strong class="font-semibold text-white">
              {clinic.legal.nipc}
            </strong>
          </li>
          <li>
            <a
              href="/privacidade-e-cookies"
              class="text-footer-muted hover:text-white focus-visible:ring-offset-footer"
            >
              Privacidade e cookies
            </a>
          </li>
          <li>
            <button
              type="button"
              data-cookie-preferences
              class="text-left text-footer-muted transition-colors duration-200 hover:text-white focus-visible:ring-offset-footer"
            >
              Preferências de cookies
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm text-footer-muted md:flex-row md:items-center md:justify-between"
    >
      <span>© {year} {clinic.name}. Todos os direitos reservados.</span>
    </div>
  </div>
</footer>
