---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
const { title, description } = Astro.props as {
  title: string;
  description?: string;
};
const desc = description ?? "Gabinete FICA — Fisioterapia e Osteopatia na Maia";
const rawGtmContainerId =
  typeof import.meta.env.PUBLIC_GTM_CONTAINER_ID === "string"
    ? import.meta.env.PUBLIC_GTM_CONTAINER_ID.trim()
    : "";
const publicGtmContainerId = /^GTM-[A-Z0-9-]+$/.test(rawGtmContainerId)
  ? rawGtmContainerId
  : "";
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf8" />
    <script is:inline define:vars={{ publicGtmContainerId }}>
      (() => {
        const cookieName = "fica_consent_preferences";
        const consentVersion = "2026-10-gtm-v1";
        const maxAgeSeconds = 15552000;
        const containerId = publicGtmContainerId;

        window.dataLayer = window.dataLayer || [];
        window.gtag =
          window.gtag ||
          function gtag() {
            window.dataLayer.push(arguments);
          };

        const consentFromPreferences = (preferences) => ({
          analytics_storage: preferences.analytics ? "granted" : "denied",
          ad_storage: preferences.marketing ? "granted" : "denied",
          ad_user_data: preferences.marketing ? "granted" : "denied",
          ad_personalization: preferences.marketing ? "granted" : "denied",
        });

        const defaultPreferences = {
          analytics: false,
          marketing: false,
        };

        window.gtag(
          "consent",
          "default",
          consentFromPreferences(defaultPreferences)
        );
        window.gtag("set", "ads_data_redaction", true);

        const hasOptionalConsent = (preferences) =>
          Boolean(preferences?.analytics || preferences?.marketing);

        const readPreferences = () => {
          const prefix = `${cookieName}=`;
          const cookie = document.cookie
            .split("; ")
            .find((row) => row.startsWith(prefix));

          if (!cookie) return null;

          try {
            const parsed = JSON.parse(
              decodeURIComponent(cookie.slice(prefix.length))
            );

            if (
              parsed?.version !== consentVersion ||
              typeof parsed.analytics !== "boolean" ||
              typeof parsed.marketing !== "boolean" ||
              typeof parsed.updatedAt !== "string" ||
              Number.isNaN(Date.parse(parsed.updatedAt))
            ) {
              return null;
            }

            return {
              version: consentVersion,
              analytics: parsed.analytics,
              marketing: parsed.marketing,
              updatedAt: parsed.updatedAt,
            };
          } catch {
            return null;
          }
        };

        const writePreferences = (preferences) => {
          const secure =
            window.location.protocol === "https:" ? "; Secure" : "";
          document.cookie = `${cookieName}=${encodeURIComponent(
            JSON.stringify(preferences)
          )}; Path=/; SameSite=Lax; Max-Age=${maxAgeSeconds}${secure}`;
        };

        const loadGtm = () => {
          if (!containerId || window.__ficaGtmLoaded) return;
          if (
            document.querySelector(
              `script[src*="googletagmanager.com/gtm.js?id=${containerId}"]`
            )
          ) {
            window.__ficaGtmLoaded = true;
            return;
          }

          window.__ficaGtmLoaded = true;
          window.dataLayer.push({
            "gtm.start": new Date().getTime(),
            event: "gtm.js",
          });

          const firstScript = document.getElementsByTagName("script")[0];
          const gtmScript = document.createElement("script");
          gtmScript.async = true;
          gtmScript.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(
            containerId
          )}`;
          firstScript.parentNode.insertBefore(gtmScript, firstScript);
        };

        const applyPreferences = (preferences, options = {}) => {
          const nextPreferences = {
            version: consentVersion,
            analytics: Boolean(preferences?.analytics),
            marketing: Boolean(preferences?.marketing),
            updatedAt:
              typeof preferences?.updatedAt === "string" &&
              !Number.isNaN(Date.parse(preferences.updatedAt))
                ? preferences.updatedAt
                : new Date().toISOString(),
          };

          window.gtag(
            "consent",
            "update",
            consentFromPreferences(nextPreferences)
          );

          if (options.persist) {
            writePreferences(nextPreferences);
          }

          if (options.emit) {
            window.dataLayer.push({
              event: "fica_consent_update",
              analyticsConsent: nextPreferences.analytics,
              marketingConsent: nextPreferences.marketing,
            });
            window.dispatchEvent(
              new CustomEvent("fica:consent-updated", {
                detail: nextPreferences,
              })
            );
          }

          if (hasOptionalConsent(nextPreferences)) {
            loadGtm();
          }

          return nextPreferences;
        };

        window.FicaConsent = {
          version: consentVersion,
          cookieName,
          readPreferences,
          savePreferences(preferences) {
            return applyPreferences(preferences, {
              persist: true,
              emit: true,
            });
          },
        };

        const storedPreferences = readPreferences();
        if (storedPreferences) {
          applyPreferences(storedPreferences);
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const allowed = new Set(["light", "dark", "computer"]);
        const storageKey = "theme";
        const themeColors = {
          light: "#fbfaf8",
          dark: "#111521",
        };
        const getStoredPreference = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return allowed.has(value) ? value : "computer";
          } catch {
            return "computer";
          }
        };
        const getSystemTheme = () =>
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        const preference = getStoredPreference();
        const theme = preference === "computer" ? getSystemTheme() : preference;

        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", themeColors[theme]);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="fica_logo.jpeg" type="image/x-icon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>

  <body class="bg-brand-wash">
    {
      publicGtmContainerId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${publicGtmContainerId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <noscript>
      <div class="bg-panel-strong px-5 py-3 text-sm text-fg ring-1 ring-line">
        As preferências de cookies requerem JavaScript. Pode consultar a
        <a href="/privacidade-e-cookies"> política de privacidade e cookies</a>.
      </div>
    </noscript>
    <slot />
    <ScrollToTop />
    <CookieConsent />
    <script is:inline>
      (() => {
        const allowed = new Set(["light", "dark", "computer"]);
        const storageKey = "theme";
        const themeColors = {
          light: "#fbfaf8",
          dark: "#111521",
        };
        const systemQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const metaThemeColor = document.querySelector('meta[name="theme-color"]');

        const getStoredPreference = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return allowed.has(value) ? value : "computer";
          } catch {
            return "computer";
          }
        };

        const storePreference = (preference) => {
          try {
            window.localStorage.setItem(storageKey, preference);
          } catch {
            // Ignore storage failures; the current page still updates.
          }
        };

        const getSystemTheme = () => (systemQuery.matches ? "dark" : "light");

        const syncControls = (preference, effectiveTheme) => {
          document.querySelectorAll("[data-theme-option]").forEach((button) => {
            const active = button.dataset.themeOption === preference;
            button.setAttribute("aria-checked", active ? "true" : "false");
            button.dataset.active = active ? "true" : "false";
          });

          document
            .querySelectorAll("[data-theme-selector]")
            .forEach((selector) => {
              selector.setAttribute(
                "aria-label",
                `Escolher tema. Atual: ${preference}. Tema aplicado: ${effectiveTheme}.`
              );
            });
        };

        const applyPreference = (preference, persist = false) => {
          const cleanPreference = allowed.has(preference)
            ? preference
            : "computer";
          const effectiveTheme =
            cleanPreference === "computer" ? getSystemTheme() : cleanPreference;

          document.documentElement.dataset.themePreference = cleanPreference;
          document.documentElement.dataset.theme = effectiveTheme;
          document.documentElement.style.colorScheme = effectiveTheme;

          if (metaThemeColor) {
            metaThemeColor.setAttribute("content", themeColors[effectiveTheme]);
          }

          if (persist) {
            storePreference(cleanPreference);
          }

          syncControls(cleanPreference, effectiveTheme);
        };

        document.addEventListener("click", (event) => {
          const target =
            event.target instanceof Element ? event.target : null;
          const button = target?.closest("[data-theme-option]");
          if (!button) return;
          applyPreference(button.dataset.themeOption, true);
        });

        const onSystemThemeChange = () => {
          if (getStoredPreference() === "computer") {
            applyPreference("computer", false);
          }
        };

        if (systemQuery.addEventListener) {
          systemQuery.addEventListener("change", onSystemThemeChange);
        } else {
          systemQuery.addListener(onSystemThemeChange);
        }

        applyPreference(getStoredPreference(), false);
        document.addEventListener("astro:page-load", () => {
          applyPreference(getStoredPreference(), false);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const reveal = () => {
          const els = Array.from(document.querySelectorAll("[data-reveal]"));
          if (!els.length) return;

          // If reduced motion, just show everything
          const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;
          if (reduce) {
            els.forEach((el) => el.classList.add("is-revealed"));
            return;
          }

          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  io.unobserve(entry.target);
                }
              }
            },
            {
              root: null,
              threshold: 0.12,
              rootMargin: "0px 0px -10% 0px",
            }
          );

          els.forEach((el) => io.observe(el));
        };

        // Run now + on Astro client navigations (if you ever enable view transitions)
        reveal();
        document.addEventListener("astro:page-load", reveal);
      })();
    </script>
  </body>
</html>
